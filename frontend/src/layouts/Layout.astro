---
interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;

const isHome = path === "/";
const isHistory = path.startsWith("/history");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">Web Monitor</a>

        <nav class="nav" aria-label="Main navigation">
          <a href="/" aria-current={isHome ? "page" : undefined}>Websites</a>
          <a href="/history" aria-current={isHistory ? "page" : undefined}>History</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafafa;
    --surface: #ffffff;
    --text: #1a1a1a;
    --muted: #5c5c5c;
    --border: #dcdcdc;
    --accent: #1d4ed8;
    --on-accent: #ffffff;
    --ok: #166534;
    --bad: #b91c1c;
    --radius: 4px;
    --container-width: 800px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111111;
      --surface: #181818;
      --text: #e8e8e8;
      --muted: #a0a0a0;
      --border: #2e2e2e;
      --accent: #8ab4ff;
      --on-accent: #0b0b0b;
      --ok: #4ade80;
      --bad: #f87171;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
  }

  a {
    color: var(--accent);
  }

  a:hover {
    text-decoration: underline;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [hidden] {
    display: none !important;
  }

  .container {
    width: min(100% - 2rem, var(--container-width));
    margin-inline: auto;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 1.25rem;
  }

  .nav a {
    padding: 0.8rem 0;
    color: var(--muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current="page"] {
    color: var(--text);
    font-weight: 600;
  }

  main {
    padding: 1.5rem 0 3rem;
  }

  h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .muted {
    color: var(--muted);
  }

  button,
  input,
  select {
    font: inherit;
    color: var(--text);
  }

  input,
  select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0.5rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  select {
    cursor: pointer;
  }

  input:hover,
  select:hover {
    border-color: var(--muted);
  }

  .btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
  }

  .btn:hover {
    border-color: var(--muted);
  }

  .btn:active {
    background: var(--bg);
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .btn.primary:hover {
    filter: brightness(1.12);
  }

  .btn.primary:active {
    filter: brightness(0.9);
  }

  .btn.danger {
    color: var(--bad);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .status::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .status.up {
    color: var(--ok);
  }

  .status.down {
    color: var(--bad);
  }

  .status.none {
    color: var(--muted);
  }

  .note {
    margin: 0.5rem 0 0;
    min-height: 1.5em;
    color: var(--muted);
  }

  .note.error {
    color: var(--bad);
  }

  .note.ok {
    color: var(--ok);
  }

  .empty {
    padding: 2rem 0;
    text-align: center;
    color: var(--muted);
  }

  .empty.error {
    color: var(--bad);
  }
</style>
